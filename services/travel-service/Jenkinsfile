// =============================================================================
// travel-service — pipeline CI (increment CI/CD n°2 : generalisation multi-jobs).
//
// Calque STRICT du Jenkinsfile d'identity-service : memes stages, memes
// garde-fous, meme commande Maven. Seuls changent le repertoire du module et le
// chemin des rapports JUnit. Cette uniformite est voulue : trois pipelines qui
// divergeraient "un peu" seraient trois pipelines a debugger separement.
//
// DECLENCHEMENT : MANUEL UNIQUEMENT.
//   Aucun bloc `triggers { ... }` ici, et le config.xml du job (rendu par le
//   role Ansible `jenkins`, template generique job-pipeline.xml.j2) porte un
//   `<triggers/>` vide. Pas de pollSCM, pas de webhook, pas de scan multibranch :
//   ce sont des increments separes. Ce pipeline se lance au bouton "Build Now"
//   ou via l'API REST / `jenkins-cli build`.
//
// CE QUE CE PIPELINE FAIT : checkout + `./mvnw test`, puis (conditionnel)
//   analyse SonarQube, build de l'image Docker et deploiement du service.
//   Aucun push vers un registre distant : l'image reste sur le demon local.
//   L'analyse SonarQube A ETE AJOUTEE (increment qualite) : deux stages
//   CONDITIONNELS, actifs seulement si la variable globale Jenkins
//   SONAR_HOST_URL est posee et si le credential `sonarqube-token`
//   existe — les deux creees MANUELLEMENT (procedure :
//   ansible/roles/sonarqube/README.md). Aucun token dans ce depot.
//
// MAVEN / DEPOT DE DEPENDANCES :
//   `./mvnw test -B --no-transfer-progress`, aligne sur le Dockerfile du service
//   (meme wrapper, memes flags ; le Dockerfile skippe les tests, pas nous).
//   AUCUN `-s settings.xml`, AUCUN mirror : les dependances viennent de Maven
//   Central via le cache ~/.m2 du conteneur Jenkins, persiste par le volume
//   nomme JENKINS_HOME.
//
// TESTCONTAINERS — SPECIFICITE DE CE SERVICE : NEO4J, PAS POSTGRES.
//   TransportGraphIntegrationTest et DestinationLifecycleIntegrationTest
//   demarrent un VRAI neo4j:5.26.6-community (meme image qu'en production).
//   Consequences concretes, toutes deja couvertes par l'infra existante :
//     - meme cablage reseau que pour les jobs postgres : le conteneur Neo4j est
//       un conteneur FRERE cree sur le demon de l'HOTE, joint via
//       TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal + extra_hosts
//       host.docker.internal:host-gateway. Ce cablage est fait UNE FOIS dans le
//       fragment Compose du role Ansible `jenkins`, commun a tous les jobs :
//       RIEN a dupliquer ici (le test lit getHost()/getMappedPort(7687), il
//       beneficie donc de l'override sans code specifique).
//     - RAM : un Neo4j 5.26 demarre plus gros qu'un postgres (~600 Mo cote
//       HOTE, hors cgroup de 1600m du controleur Jenkins). C'est une raison de
//       plus de ne pas lancer les 3 jobs du monorepo en parallele.
//     - Duree : le premier demarrage du conteneur Neo4j (pull + bootstrap du
//       store) est nettement plus lent qu'un postgres ; le timeout de 30 min
//       ci-dessous couvre largement ce cas, y compris pull inclus.
//   Le mot de passe admin du conteneur de test est defini DANS le code de test
//   (credential jetable d'un conteneur ephemere, cf. `withAdminPassword`) : rien
//   n'est injecte par ce pipeline, aucun secret ne transite par Jenkins.
// =============================================================================

pipeline {
    // Pas d'agent dedie dans cet increment : le build tourne sur le controleur.
    // Le fragment Compose dimensionne mem_limit en consequence (1600m) pour UN
    // build a la fois.
    agent any

    options {
        // JENKINS_HOME vit dans un volume sur une machine a 8 Go : on borne
        // l'historique conserve (coherent avec le BuildDiscarder du config.xml).
        buildDiscarder(logRotator(numToKeepStr: '10'))
        // Deux builds concurrents = deux JVM Maven + deux JVM Surefire dans la
        // meme cgroup de 1600m => OOM kill garanti. On serialise.
        disableConcurrentBuilds()
        // Filet : un premier build telecharge Maven + tout le repo de deps, et
        // pull l'image neo4j:5.26.6-community.
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        // Heap de la JVM Maven bornee (meme discipline que les JVM du projet,
        // cf. docs/architecture-decisions.md §4). La JVM forkee par Surefire
        // reste container-aware et se borne sur mem_limit.
        MAVEN_OPTS = '-Xmx256m'
    }

    stages {

        stage('Checkout') {
            steps {
                // `scm` = la configuration Git du job (miroir local file://,
                // branche main). Aucun credential : rien a authentifier.
                checkout scm
            }
        }

        stage('Test') {
            steps {
                // Le Jenkinsfile est a la racine de travel-service, mais le
                // checkout ramene la RACINE DU DEPOT : on se place dans le
                // module avant de lancer le wrapper.
                dir('services/travel-service') {
                    // -B = batch (pas de couleurs/prompts), --no-transfer-progress
                    // = pas de barre de telechargement dans le log de build.
                    sh './mvnw test -B --no-transfer-progress'
                }
            }
        }

        // ---------------------------------------------------------------
        // Analyse SonarQube.
        //
        // CONDITIONNEE, PAS OPTIONNELLE PAR CONFORT : le serveur SonarQube
        // appartient au profil Compose `ci` et n'est donc PAS toujours la
        // (docs/architecture-decisions.md §8 : la stack CI se lance a la
        // demande sur une machine a 8 Go). `when` evite de faire echouer
        // tout le pipeline quand seule la partie test est voulue.
        //
        // SONAR_HOST_URL : variable globale Jenkins (Manage Jenkins >
        // System > Global properties), a poser MANUELLEMENT. Valeur
        // attendue depuis le conteneur Jenkins : http://sonarqube:9000
        // (nom de service Compose sur backend-net) — PAS l'URL Traefik
        // https://sonarqube.localhost, dont le certificat auto-signe
        // n'est pas dans le truststore de la JVM du scanner.
        //
        // SONAR_TOKEN : credential Jenkins de type "Secret text", d'ID
        // `sonarqube-token`, cree MANUELLEMENT (procedure dans
        // ansible/roles/sonarqube/README.md). Aucun token n'est ecrit
        // dans ce depot ni provisionne par Ansible : Vault n'est pas
        // cable a la chaine CI dans cet increment, et le contrat du
        // projet interdit le placeholder "temporaire".
        //
        // Pas de `withSonarQubeEnv` / `waitForQualityGate` : ces steps
        // viennent du plugin Jenkins SonarQube Scanner, qui n'est PAS
        // installe (le role `jenkins` provisionne un jeu de plugins
        // ferme). Le quality gate est donc relu via l'API REST, ci-dessous.
        stage('SonarQube analysis') {
            when {
                expression { return env.SONAR_HOST_URL?.trim() }
            }
            environment {
                SONAR_TOKEN = credentials('sonarqube-token')
            }
            steps {
                dir('services/travel-service') {
                    // `verify -DskipTests` : sonar:sonar a besoin des classes
                    // compilees ET du packaging ; les tests viennent d'etre
                    // joues au stage precedent, on ne les rejoue pas (deux
                    // Testcontainers de suite dans 1600m de cgroup = OOM).
                    // -Dsonar.coverage.jacoco.xmlReportPaths : le stage "Test"
                    // qui vient de tourner (JaCoCo lie a la phase `test` dans
                    // le pom.xml) a deja produit target/site/jacoco/jacoco.xml
                    // dans CE MEME workspace (meme `dir()`, pas de stash/unstash
                    // entre les deux stages) ; on le pointe explicitement pour
                    // que le scanner l'attache SANS rejouer les tests.
                    sh '''
                        ./mvnw verify sonar:sonar -B --no-transfer-progress \
                          -DskipTests \
                          -Dsonar.host.url="$SONAR_HOST_URL" \
                          -Dsonar.token="$SONAR_TOKEN" \
                          -Dsonar.projectKey=travel-plan-travel-service \
                          -Dsonar.projectName="Travel-Plan Travel Service" \
                          -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                    '''
                }
            }
        }

        // Relecture du quality gate par l'API REST. Le scanner rend la main
        // DES que le rapport est televerse : c'est le Compute Engine du
        // serveur qui calcule ensuite les issues et le gate, de facon
        // ASYNCHRONE. Sans cette attente, un `sonar:sonar` vert ne dit
        // strictement rien de la qualite du code.
        //
        // PIEGE REEL, rencontre sur cette instance : interroger
        // `qualitygates/project_status?projectKey=...` SANS ancrer sur la
        // tache d'analyse precise renvoie le statut de la DERNIERE analyse
        // CONNUE du serveur, qui reste celui de l'analyse precedente tant
        // que le Compute Engine n'a pas fini de traiter le rapport qu'on
        // vient d'envoyer. Un build a echoue sur un gate ERROR perime alors
        // que la nouvelle analyse (deja verte) etait encore en cours de
        // calcul. Fix : on capture le `ceTaskId` du rapport
        // (target/sonar/report-task.txt, ecrit par le stage precedent),
        // on attend que `api/ce/task?id=...` passe a SUCCESS, on en tire
        // l'`analysisId` DE CETTE analyse, et c'est CE seul identifiant
        // qu'on interroge sur `qualitygates/project_status` — jamais le
        // projectKey seul.
        stage('Quality gate') {
            when {
                expression { return env.SONAR_HOST_URL?.trim() }
            }
            environment {
                SONAR_TOKEN = credentials('sonarqube-token')
            }
            steps {
                dir('services/travel-service') {
                    // curl est present dans l'image jenkins/jenkins:lts
                    // (base Debian). `set -e` + test explicite sur la
                    // valeur : un status ERROR fait echouer le build.
                    sh '''
                        set -e
                        ce_task_id=$(grep '^ceTaskId=' target/sonar/report-task.txt | cut -d= -f2)

                        ce_status=""
                        ce_response=""
                        for i in $(seq 1 60); do
                          ce_response=$(curl -sf -u "$SONAR_TOKEN:" \
                            "$SONAR_HOST_URL/api/ce/task?id=$ce_task_id")
                          ce_status=$(echo "$ce_response" | grep -oE '"status":"[A-Z]*"' | head -1 | cut -d'"' -f4)
                          case "$ce_status" in
                            SUCCESS) break ;;
                            FAILED|CANCELED) echo "Tache Compute Engine terminee en $ce_status"; exit 1 ;;
                            *) echo "Tache Compute Engine pas encore terminee ($ce_status), attente..."; sleep 5 ;;
                          esac
                        done
                        if [ "$ce_status" != "SUCCESS" ]; then
                          echo "Timeout: le Compute Engine n a pas termine la tache $ce_task_id en 5 min"
                          exit 1
                        fi

                        analysis_id=$(echo "$ce_response" | grep -oE '"analysisId":"[^"]*"' | head -1 | cut -d'"' -f4)
                        status=$(curl -sf -u "$SONAR_TOKEN:" \
                            "$SONAR_HOST_URL/api/qualitygates/project_status?analysisId=$analysis_id" \
                            | grep -oE '"status":"[A-Z_]*"' | head -1 | cut -d'"' -f4)

                        case "$status" in
                          OK) echo "Quality gate: OK"; exit 0 ;;
                          *)  echo "Quality gate: $status"; exit 1 ;;
                        esac
                    '''
                }
            }
        }

        // ---------------------------------------------------------------
        // Build d'image + deploiement (increment CD).
        //
        // CONDITIONNES a la presence du docker-compose.yml de la stack dans
        // le conteneur Jenkins, c'est-a-dire a `jenkins_deploy_enabled=true`
        // dans le role Ansible `jenkins` (client docker + compose + repertoire
        // de la stack montes en lecture seule). Sans ce montage, ces stages
        // sont SAUTES et le pipeline reste un pipeline de test.
        //
        // Ils ne tournent qu'apres Test + analyse + quality gate : une image
        // n'est jamais construite ni deployee depuis un commit qui a echoue.
        //
        // Le tag `0.1.0` est celui que le fragment Compose du service attend
        // (`image:` + `build:`) ; on ajoute un tag immuable par commit pour la
        // tracabilite, et `previous` pour le rollback ci-dessous.
        stage('Build image') {
            when {
                expression { return fileExists('/opt/travel-plan/docker-compose.yml') }
            }
            steps {
                sh '''
                    set -e
                    # Sauvegarde de l'image en production (absente au 1er deploiement).
                    docker tag travel-plan/travel-service:0.1.0 travel-plan/travel-service:previous 2>/dev/null || true
                    short=$(git rev-parse --short HEAD)
                    docker build \
                      -t travel-plan/travel-service:0.1.0 \
                      -t travel-plan/travel-service:"$short" \
                      services/travel-service
                '''
            }
        }

        // Deploiement = `docker compose up` du seul service, sans rebuild
        // (`--no-build` : on deploie l'image qu'on vient de construire et de
        // tester) ni dependances (`--no-deps` : on ne touche ni aux bases ni a
        // Traefik). Puis smoke test : toutes les replicas doivent etre
        // `healthy` (healthcheck du fragment) sous 3 min, sinon ROLLBACK sur
        // l'image `previous` et echec du build.
        stage('Deploy') {
            when {
                expression { return fileExists('/opt/travel-plan/docker-compose.yml') }
            }
            steps {
                sh '''
                    set -e
                    compose="docker compose -p travel-plan --project-directory /opt/travel-plan -f /opt/travel-plan/docker-compose.yml --profile full"

                    wait_healthy() {
                      for i in $(seq 1 36); do
                        ids=$($compose ps -q travel-service)
                        ok=1
                        [ -n "$ids" ] || ok=0
                        for id in $ids; do
                          [ "$(docker inspect -f '{{.State.Health.Status}}' "$id")" = healthy ] || ok=0
                        done
                        [ "$ok" = 1 ] && return 0
                        sleep 5
                      done
                      return 1
                    }

                    $compose up -d --no-build --no-deps --force-recreate travel-service
                    if wait_healthy; then
                      echo "Deploiement OK : travel-service healthy"
                      exit 0
                    fi

                    echo "Smoke test KO : rollback sur travel-plan/travel-service:previous"
                    if docker image inspect travel-plan/travel-service:previous >/dev/null 2>&1; then
                      docker tag travel-plan/travel-service:previous travel-plan/travel-service:0.1.0
                      $compose up -d --no-build --no-deps --force-recreate travel-service
                    fi
                    exit 1
                '''
            }
        }
    }

    post {
        always {
            // Rend les resultats JUnit lisibles dans l'UI plutot que noyes dans
            // le log. Chemin par defaut de Surefire (le pom ne le surcharge pas).
            // allowEmptyResults:false => un run qui ne produit AUCUN rapport est
            // un echec, pas un "succes vide" trompeur.
            junit allowEmptyResults: false,
                  testResults: 'services/travel-service/target/surefire-reports/TEST-*.xml'
        }
    }
}
